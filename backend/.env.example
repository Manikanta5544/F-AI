# ======================
# APP
# ======================
APP_NAME=F-AI
ENVIRONMENT=development
DEBUG=true

# ======================
# API
# ======================
API_V1_PREFIX=/api/v1

# ======================
# DATABASE (ASYNC - FastAPI)
# ======================
DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:5432/f_ai

# ======================
# DATABASE (SYNC - Alembic)
# ======================
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:password@127.0.0.1:5432/f_ai

# ======================
# REDIS (Celery + Cache)
# ======================
REDIS_URL=redis://localhost:6379/0

# ======================
# SECURITY
# ======================
SECRET_KEY=supersecretkey123
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ======================
# STORAGE (S3 / MinIO optional)
# ======================
MINIO_BUCKET=f-ai-bucket
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=http://localhost:9000

# ======================
# FEATURE FLAGS
# ======================
ENABLE_YOLO=true
ENABLE_OCR_ENSEMBLE=true